{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BD-WM-SA-D/joblens/schemas/kafka/parse_error.v1.json",
  "x-version": "1.0.0",
  "title": "parse_error v1",
  "description": "Bản ghi lỗi parser trên topic dlq.parse_errors.v1. Kafka key = source. Repo ghi: Web-mining-joblens (parser của crawler) – repo duy nhất ghi topic này. Message sai schema khi nạp bronze thì BD ghi vào bảng nội bộ bronze.ingest_errors, không ghi topic này. Không chép nguyên HTML vào đây.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "error_type",
    "error_message",
    "error_ts"
  ],
  "properties": {
    "schema_version": {
      "const": "parse_error.v1"
    },
    "source": {
      "enum": [
        "topcv",
        "itviec",
        "vietjobs",
        "synthetic"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_type": {
      "description": "Mã lỗi ngắn, ví dụ missing_title, schema_violation, http_403.",
      "type": "string",
      "minLength": 1
    },
    "error_message": {
      "type": "string",
      "maxLength": 2000
    },
    "error_ts": {
      "type": "string",
      "format": "date-time"
    },
    "component_version": {
      "description": "Version parser.",
      "type": [
        "string",
        "null"
      ]
    },
    "raw_html_uri": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^s3://"
    }
  }
}
