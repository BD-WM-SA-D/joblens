{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BD-WM-SA-D/joblens/schemas/tables/_contract.schema.json",
  "title": "Định dạng contract bảng JobLens",
  "description": "Mọi file schemas/tables/<zone>/<bảng>.yaml phải khớp schema này (kiểm tra trong tests/test_contracts.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["table", "version", "status", "description", "writer_repo", "writer_component", "readers", "write_mode", "partition_spec", "primary_key", "columns"],
  "properties": {
    "table": { "type": "string", "pattern": "^(bronze|silver|gold)\\.[a-z][a-z0-9_]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "description": "draft = đang chờ ADR/nhóm duyệt, được phép đổi; stable = đổi phải theo SemVer.", "enum": ["draft", "stable"] },
    "description": { "type": "string", "minLength": 1 },
    "writer_repo": { "$ref": "#/$defs/repo" },
    "writer_component": { "description": "Job/thành phần ghi bảng, ví dụ spark-jobs/silver_job_postings.py hoặc image skill-extractor.", "type": "string", "minLength": 1 },
    "readers": { "type": "array", "items": { "$ref": "#/$defs/repo" }, "uniqueItems": true },
    "used_by": { "description": "Ca sử dụng / bài khai phá dùng bảng.", "type": "array", "items": { "type": "string", "pattern": "^(UC[0-9]{3}|WM[0-9])$" } },
    "write_mode": { "enum": ["append", "merge", "overwrite_partition", "dbt"] },
    "partition_spec": { "type": "array", "items": { "type": "string", "pattern": "^([a-z_]+\\(([0-9]+, )?[a-z0-9_]+\\)|[a-z0-9_]+)$" } },
    "primary_key": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "grain": { "description": "Một dòng ứng với gì (bắt buộc với gold).", "type": "string" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "nullable", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "pattern": "^(string|int|long|double|boolean|date|timestamp|list<(string|long|double)>)$" },
          "nullable": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "unit": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "repo": { "enum": ["joblens", "Big-Data-Storage-and-Processing-joblens", "Web-mining-joblens", "PTTKHT-joblens"] }
  }
}
